local function _b64decode(value)
    local result = {}
    local buffer, bits = 0, 0
    for i = 1, #value do
        local ch = value:sub(i, i)
        if ch ~= "=" then
            local pos = _b:find(ch, 1, true)
            if not pos then error("invalid payload") end
            buffer = buffer * 64 + pos - 1
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                result[#result + 1] = string.char(math.floor(buffer / (2 ^ bits)) % 256)
                buffer = buffer % (2 ^ bits)
            end
        end
    end
    return table.concat(result)
end

local function _restore(value)
    local output = {}
    for i = 1, #value do
        local byte = string.byte(value, i)
        output[i] = string.char((byte - _k - ((i * _s) % 256)) % 256)
    end
    return table.concat(output)
end

