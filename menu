local _vehicleSpeedConn=nil
local _vehicleSpeedSeat=nil
local _vehicleSpeedOriginalMax=nil
local _vehicleSpeedOriginalTorque=nil
local function RestoreVehicleSpeed()
    if _vehicleSpeedSeat and _vehicleSpeedSeat.Parent then
        if _vehicleSpeedOriginalMax~=nil then pcall(function() _vehicleSpeedSeat.MaxSpeed=_vehicleSpeedOriginalMax end) end
        if _vehicleSpeedOriginalTorque~=nil then pcall(function() _vehicleSpeedSeat.Torque=_vehicleSpeedOriginalTorque end) end
    end
    _vehicleSpeedSeat=nil
    _vehicleSpeedOriginalMax=nil
    _vehicleSpeedOriginalTorque=nil
end
local function DisableVehicleSpeed()
    if _vehicleSpeedConn then _vehicleSpeedConn:Disconnect(); _vehicleSpeedConn=nil end
    RestoreVehicleSpeed()
end
local function EnableVehicleSpeed()
    if _vehicleSpeedConn then return end
    _vehicleSpeedConn=AC(RunService.Heartbeat:Connect(function(dt)
        if not Cfg.Misc.VehicleSpeed then return end
        local model,part,seat=GetVehicleModel()
        if not model or not part or not part.Parent or not seat or not seat:IsA("VehicleSeat") then
            RestoreVehicleSpeed()
            return
        end
        if seat~=_vehicleSpeedSeat then
            RestoreVehicleSpeed()
            _vehicleSpeedSeat=seat
            _vehicleSpeedOriginalMax=seat.MaxSpeed
            _vehicleSpeedOriginalTorque=seat.Torque
        end
        local desired=math.clamp(tonumber(Cfg.Misc.VehicleSpeedValue) or 100,10,1000)
        pcall(function()
            seat.MaxSpeed=desired
            seat.Torque=math.max(_vehicleSpeedOriginalTorque or 0,desired*35)
        end)
        -- Assistência progressiva: acelera até o limite, sem teletransportar a velocidade.
        local throttle=0
        pcall(function() throttle=seat.ThrottleFloat end)
        if math.abs(throttle)>0.01 then
            local current=part.AssemblyLinearVelocity
            local horizontal=Vector3.new(current.X,0,current.Z)
            local forward=Vector3.new(part.CFrame.LookVector.X,0,part.CFrame.LookVector.Z)
            if horizontal.Magnitude>1 then forward=horizontal.Unit elseif forward.Magnitude>0.01 then forward=forward.Unit else forward=Vector3.new(0,0,-1) end
            local acceleration=math.max(desired*2.5,40)
            local nextSpeed=math.min(desired,horizontal.Magnitude+acceleration*(tonumber(dt) or 1/60))
            if horizontal.Magnitude<desired then
                part.AssemblyLinearVelocity=forward*(nextSpeed*math.sign(throttle))+Vector3.new(0,current.Y,0)
            end
        end
    end))
end
local _vehicleNoclipConn=nil
local _vehicleNoclipModel=nil
local _vehicleNoclipOriginals={}
local _vehicleNoclipGroup="223JVehicleNoclip"
local _vehicleNoclipLifts={}
local function EnsureVehicleNoclipGroup()
    return pcall(function()
        if not PhysicsService:IsCollisionGroupRegistered(_vehicleNoclipGroup) then PhysicsService:RegisterCollisionGroup(_vehicleNoclipGroup) end
        for _,info in ipairs(PhysicsService:GetRegisteredCollisionGroups()) do
            PhysicsService:CollisionGroupSetCollidable(_vehicleNoclipGroup,info.name,false)
        end
        PhysicsService:CollisionGroupSetCollidable(_vehicleNoclipGroup,_vehicleNoclipGroup,false)
    end)
end
local function RestoreVehicleNoclip()
    for root,force in pairs(_vehicleNoclipLifts) do if force then pcall(function() force:Destroy() end) end end
    _vehicleNoclipLifts={}
    for part,state in pairs(_vehicleNoclipOriginals) do
        if part and part.Parent then pcall(function()
            part.CollisionGroup=state.CollisionGroup
            part.CanCollide=state.CanCollide
            if state.CanTouch~=nil then part.CanTouch=state.CanTouch end
            if state.CanQuery~=nil then part.CanQuery=state.CanQuery end
        end) end
    end
    _vehicleNoclipOriginals={}
    _vehicleNoclipModel=nil
end
local function SaveVehicleNoclipPart(part)
    if not part or not part:IsA("BasePart") then return end
    if _vehicleNoclipOriginals[part]==nil then _vehicleNoclipOriginals[part]={CollisionGroup=part.CollisionGroup,CanCollide=part.CanCollide,CanTouch=part.CanTouch,CanQuery=part.CanQuery} end
    pcall(function() part.CollisionGroup=_vehicleNoclipGroup; part.CanCollide=false; part.CanTouch=false; part.CanQuery=false end)
    local assembly=part.AssemblyRootPart or part
    if assembly and assembly.Parent and not _vehicleNoclipLifts[assembly] then
        local force=Instance.new("BodyForce")
        force.Name="223VehicleNoclipGravityCompensation"
        force.Force=Vector3.new(0,assembly.AssemblyMass*Workspace.Gravity,0)
        force.Parent=assembly
        _vehicleNoclipLifts[assembly]=force
    end
end
local function ApplyVehicleOccupantNoclip(model)
    for _,player in ipairs(Players:GetPlayers()) do
        local char=player.Character
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        local seat=hum and hum.SeatPart
        if seat and model and seat:IsDescendantOf(model) then
            for _,obj in ipairs(char:GetDescendants()) do if obj:IsA("BasePart") then SaveVehicleNoclipPart(obj) end end
        end
    end
end
local function DisableVehicleNoclip()
    if _vehicleNoclipConn then _vehicleNoclipConn:Disconnect(); _vehicleNoclipConn=nil end
    RestoreVehicleNoclip()
end
local function EnableVehicleNoclip()
    if _vehicleNoclipConn then return end
    EnsureVehicleNoclipGroup()
    _vehicleNoclipConn=AC(RunService.Stepped:Connect(function()
        if not Cfg.Misc.VehicleNoclip then return end
        local model=GetVehicleModel()
        if model~=_vehicleNoclipModel then
            RestoreVehicleNoclip()
            _vehicleNoclipModel=model
        end
        if not model then return end
        for _,obj in ipairs(model:GetDescendants()) do if obj:IsA("BasePart") then SaveVehicleNoclipPart(obj) end end
        ApplyVehicleOccupantNoclip(model)
        for root,force in pairs(_vehicleNoclipLifts) do
            if root and root.Parent and force and force.Parent then force.Force=Vector3.new(0,root.AssemblyMass*Workspace.Gravity,0) end
        end
    end))
end
