            if code then
                cn:Disconnect(); waitingBind=false
                setBind(code,name)
                SetBindButtonTitle(entry,bindLabel(),title)
                NotifyBindConflicts()
                Fluent:Notify({Title="Bind updated",Content=title.." = "..name,Duration=2})
            end
                end)
    end})
