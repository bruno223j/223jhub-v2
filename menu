local function ShutdownHub()
    if _hubShutdown then return end
    -- Stop every feature first.
    Cfg.Misc.Fly=false; Cfg.Misc.VehicleFly=false; Cfg.Misc.VehicleSpeed=false; Cfg.Misc.VehicleNoclip=false; Cfg.Misc.Telekinesis=false; Cfg.Misc.Noclip=false; Cfg.Misc.Speed=false; Cfg.Misc.HitboxExtender=false
