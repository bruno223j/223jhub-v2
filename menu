_TK.FindVehicle=function(part)
    if not part or not part:IsA("BasePart") then return nil end
    local node=part
    while node and node~=Workspace do
        if node:IsA("Model") then
            local seat=node:FindFirstChildWhichIsA("VehicleSeat",true) or node:FindFirstChildWhichIsA("Seat",true)
            if seat then return node end
        end
        node=node.Parent
    end
    return nil
end
_TK.EnableSimulationRadius=function()
    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LP,"SimulationRadius",math.huge)
            sethiddenproperty(LP,"MaxSimulationRadius",math.huge)
        end
    end)
end
_TK.VehicleRoot=function(model)
    if not model then return nil end
    local seat=model:FindFirstChildWhichIsA("VehicleSeat",true) or model:FindFirstChildWhichIsA("Seat",true)
    local root=seat and seat.AssemblyRootPart
    if root and root:IsA("BasePart") and not root.Anchored then return root end
    if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") and not model.PrimaryPart.Anchored then return model.PrimaryPart.AssemblyRootPart or model.PrimaryPart end
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored then
            local assembly=obj.AssemblyRootPart
            if assembly and assembly:IsA("BasePart") and not assembly.Anchored then return assembly end
        end
    end
    return nil
end
_TK.HoldPosition=function()
    local char=LP.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    return root and root.Position+Vector3.new(0,10,0) or nil
end
_TK.Direction=function()
    local direction=Cam.CFrame.LookVector+Vector3.new(0,0.35,0)
    if direction.Magnitude<0.001 then direction=Vector3.new(0,1,0) end
    return direction.Unit
end
_TK.StableHoldCFrame=function(position)
    local look=Vector3.new(Cam.CFrame.LookVector.X,0,Cam.CFrame.LookVector.Z)
    if look.Magnitude<0.01 then look=Vector3.new(0,0,-1) end
    return CFrame.lookAt(position,position+look.Unit,Vector3.yAxis)
end
_TK.Impulse=function(root,model)
    if not root or not root.Parent or root.Anchored then return false end
    _TK.EnableSimulationRadius()
    local force=math.clamp(tonumber(Cfg.Misc.TelekinesisForce) or 1000,100,3000)
    local direction=_TK.Direction()
    local mass=math.clamp(tonumber(root.AssemblyMass) or 1,1,1000000)
    return pcall(function()
        root:ApplyImpulse(direction*mass*force)
        root.AssemblyLinearVelocity=direction*force
        root.AssemblyAngularVelocity=Cam.CFrame.RightVector*math.clamp(force*0.15,20,450)
    end)
end
local function FindTelekinesisShoulder(char)
    if not char then return nil,"R6" end
    local upper=char:FindFirstChild("UpperTorso")
    if upper then
        local joint=upper:FindFirstChild("RightShoulder") or char:FindFirstChild("RightShoulder",true)
        if joint and joint:IsA("Motor6D") then return joint,"R15" end
    end
    local torso=char:FindFirstChild("Torso")
    if torso then
        local joint=torso:FindFirstChild("Right Shoulder") or char:FindFirstChild("Right Shoulder",true)
        if joint and joint:IsA("Motor6D") then return joint,"R6" end
    end
    return nil,"R6"
end
local function StopTelekinesisHandPose()
    if _TK.HandPoseConn then _TK.HandPoseConn:Disconnect(); _TK.HandPoseConn=nil end
    local pose=_TK.HandPose
    _TK.HandPose=nil
    if pose and pose.joint and pose.joint.Parent and pose.base then
        pcall(function() pose.joint.Transform=pose.base end)
    end
end
local function StartTelekinesisHandPose()
    StopTelekinesisHandPose()
    local joint,rig=FindTelekinesisShoulder(LP.Character)
    if not joint then return end
    local goal
    if rig=="R15" then
        goal=CFrame.Angles(math.rad(-62),math.rad(12),math.rad(28))
    else
        goal=CFrame.Angles(0,math.rad(-8),math.rad(112))
    end
    _TK.HandPose={joint=joint,base=joint.Transform,goal=goal,alpha=0}
    _TK.HandPoseConn=RunService.RenderStepped:Connect(function(dt)
        local pose=_TK.HandPose
        if not pose or not pose.joint or not pose.joint.Parent then StopTelekinesisHandPose(); return end
        pose.alpha=math.min(1,pose.alpha+math.max(dt,1/240)*7)
        pcall(function() pose.joint.Transform=pose.base:Lerp(pose.goal,pose.alpha) end)
    end)
end
_TK.Release=function()
    StopTelekinesisHandPose()
    if _TK.HoldConn then _TK.HoldConn:Disconnect(); _TK.HoldConn=nil end
    local held=_TK.Held
    _TK.Held=nil
    if held then
        if held.bodyPosition then pcall(function() held.bodyPosition:Destroy() end) end
        if held.bodyGyro then pcall(function() held.bodyGyro:Destroy() end) end
        for part,canCollide in pairs(held.collisionOriginals or {}) do
            if part and part.Parent then pcall(function() part.CanCollide=canCollide end) end
        end
    end
end
_TK.Hold=function(kind,model,root)
    _TK.Release()
    _TK.EnableSimulationRadius()
    if not root or not root.Parent then return false end
    local bodyPosition=Instance.new("BodyPosition")
    bodyPosition.Name="223TelekinesisHold"
    bodyPosition.MaxForce=Vector3.new(1e9,1e9,1e9)
    bodyPosition.P=100000; bodyPosition.D=6000
    bodyPosition.Position=_TK.HoldPosition() or root.Position
    bodyPosition.Parent=root
    local bodyGyro=Instance.new("BodyGyro")
    bodyGyro.Name="223TelekinesisRotation"
    bodyGyro.MaxTorque=Vector3.new(1e9,1e9,1e9)
    bodyGyro.P=50000; bodyGyro.D=5000
    bodyGyro.CFrame=_TK.StableHoldCFrame(bodyPosition.Position)
    bodyGyro.Parent=root
    local collisionOriginals={}
    if model then
        for _,obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then
                collisionOriginals[obj]=obj.CanCollide
                pcall(function() obj.CanCollide=false end)
            end
        end
    end
    _TK.Held={kind=kind,model=model,root=root,bodyPosition=bodyPosition,bodyGyro=bodyGyro,collisionOriginals=collisionOriginals}
    StartTelekinesisHandPose()
    _TK.HoldConn=AC(RunService.RenderStepped:Connect(function()
        local held=_TK.Held
        local holdPosition=_TK.HoldPosition()
        if not held or not holdPosition or not held.root or not held.root.Parent or held.root.Anchored or (held.model and not held.model.Parent) then _TK.Release(); return end
        pcall(function()
            local holdCFrame=_TK.StableHoldCFrame(holdPosition)
            held.bodyPosition.Position=holdPosition
            held.bodyGyro.CFrame=holdCFrame
            held.root.AssemblyLinearVelocity=Vector3.zero
            held.root.AssemblyAngularVelocity=Vector3.zero
        end)
    end))
    return true
end
_TK.FindTarget=function()
    local target=Mouse.Target
    local vehicle=_TK.FindVehicle(target)
    if vehicle then
        local root=_TK.VehicleRoot(vehicle)
        if root then return "Vehicle",vehicle,root end
    end
    return nil
end
_TK.ThrowCursor=function()
    local _,model,root=_TK.FindTarget()
    if not root then
        Fluent:Notify({Title="Telecinese",Content="Aponte o cursor para um veículo antes de usar a tecla.",Duration=2})
        return
    end
    local ok=_TK.Impulse(root,model)
    if ok then Fluent:Notify({Title="Telecinese",Content="Veículo arremessado.",Duration=2}) end
end
_TK.ThrowHeld=function()
    local held=_TK.Held
    if not held or not held.root then return end
    local root=held.root
    _TK.Release()
    if _TK.Impulse(root,held.model) then Fluent:Notify({Title="Telecinese",Content="Veículo lançado.",Duration=2}) end
end
_TK.Action=function()
    local now=os.clock()
    if now-_tkLastAction<0.18 then return end
    _tkLastAction=now
    if _TK.Held then
        Fluent:Notify({Title="Telecinese",Content="Clique com o botão esquerdo para lançar o alvo segurado.",Duration=2})
        return
    end
    if Cfg.Misc.TelekinesisMode=="Direct" then _TK.ThrowCursor(); return end
    local _,model,root=_TK.FindTarget()
    if not root then
        Fluent:Notify({Title="Telecinese",Content="Aponte o cursor para um veículo antes de segurar.",Duration=2})
        return
    end
    if _TK.Hold("Vehicle",model,root) then Fluent:Notify({Title="Telecinese",Content="Veículo segurado acima de você. Clique para lançar.",Duration=2}) end
end

local function AlignAllPlayersForTest()
    local char=LP.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        Fluent:Notify({Title="Matar todos",Content="Seu personagem ainda não está pronto.",Duration=2})
        return
    end
    local forward=Vector3.new(Cam.CFrame.LookVector.X,0,Cam.CFrame.LookVector.Z)
    if forward.Magnitude<0.01 then forward=Vector3.new(0,0,-1) end
    forward=forward.Unit
    local right=Vector3.new(-forward.Z,0,forward.X)
    local targets={}
    for _,player in ipairs(Players:GetPlayers()) do
        if player~=LP and player.Character and player.Character.Parent then
            local hum=player.Character:FindFirstChildOfClass("Humanoid")
            local head=player.Character:FindFirstChild("Head")
            if hum and hum.Health>0 and head then targets[#targets+1]=player end
        end
    end
    local center=root.Position+forward*22+Vector3.new(0,0.5,0)
    for index,player in ipairs(targets) do
        local offset=(index-(#targets+1)/2)*4
        local position=center+right*offset
        local targetChar=player.Character
        pcall(function()
            targetChar:PivotTo(CFrame.lookAt(position,root.Position,Vector3.yAxis))
        end)
    end
    Fluent:Notify({Title="Matar todos",Content=(#targets>0 and ("Alvos alinhados: "..#targets) or "Nenhum alvo vivo encontrado."),Duration=3})
end

local _alignedTargets={}
local _alignmentConn=nil
local function UnalignAllPlayers(silent)
    if _alignmentConn then _alignmentConn:Disconnect(); _alignmentConn=nil end
    for player,state in pairs(_alignedTargets) do
        if state.Character and state.Character.Parent and state.OriginalPivot then pcall(function() state.Character:PivotTo(state.OriginalPivot) end) end
        if state.Humanoid and state.Humanoid.Parent and state.AutoRotate~=nil then pcall(function() state.Humanoid.AutoRotate=state.AutoRotate end) end
    end
    _alignedTargets={}
    if not silent then Fluent:Notify({Title="Matar todos",Content="Alvos desalinhados e posições restauradas.",Duration=3}) end
end
local function AlignAllPlayersForTest()
    local char=LP.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then Fluent:Notify({Title="Matar todos",Content="Seu personagem ainda não está pronto.",Duration=2}); return end
    UnalignAllPlayers(true)
    local forward=Vector3.new(Cam.CFrame.LookVector.X,0,Cam.CFrame.LookVector.Z)
    if forward.Magnitude<0.01 then forward=Vector3.new(0,0,-1) end
    forward=forward.Unit
    local right=Vector3.new(-forward.Z,0,forward.X)
    local targets={}
    for _,player in ipairs(Players:GetPlayers()) do
        if player~=LP and player.Character and player.Character.Parent then
            local hum=player.Character:FindFirstChildOfClass("Humanoid")
            local head=player.Character:FindFirstChild("Head")
            local targetRoot=player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health>0 and head and targetRoot then targets[#targets+1]=player end
        end
    end
    local center=root.Position+forward*22+Vector3.new(0,0.5,0)
    for index,player in ipairs(targets) do
        local targetChar=player.Character
        local targetHum=targetChar:FindFirstChildOfClass("Humanoid")
        local targetRoot=targetChar:FindFirstChild("HumanoidRootPart")
        local offset=(index-(#targets+1)/2)*4
        local desired=CFrame.lookAt(center+right*offset,root.Position,Vector3.yAxis)
        _alignedTargets[player]={Character=targetChar,Humanoid=targetHum,OriginalPivot=targetChar:GetPivot(),Desired=desired,AutoRotate=targetHum.AutoRotate}
        pcall(function() targetHum.AutoRotate=false; targetChar:PivotTo(desired) end)
    end
    if #targets>0 then
        _alignmentConn=AC(RunService.Heartbeat:Connect(function()
            for player,state in pairs(_alignedTargets) do
                if not player.Parent or not state.Character or not state.Character.Parent then
                    _alignedTargets[player]=nil
                else
                    pcall(function() state.Character:PivotTo(state.Desired) end)
                end
            end
        end))
    end
    Fluent:Notify({Title="Matar todos",Content=(#targets>0 and ("Alvos alinhados: "..#targets) or "Nenhum alvo vivo encontrado."),Duration=3})
end

